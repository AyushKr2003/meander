{
  "name": "lsd",
  "category": "tools",
  "icon": "",
  "detect": {
    "bin": [
      "lsd"
    ]
  },
  "templates": [
    {
      "input": "meander.yaml",
      "output": "$XDG_CONFIG_HOME/lsd/meander.yaml"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": [
        "$XDG_CONFIG_HOME/lsd/config.yaml",
        "$XDG_CONFIG_HOME/lsd/config.yml"
      ],
      "line": [
        "color:",
        "  theme: $XDG_CONFIG_HOME/lsd/meander.yaml"
      ],
      "skip_if": "^color\\s*:",
      "create": true
    }
  ]
}
